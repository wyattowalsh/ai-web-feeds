# ai-web-feeds Environment Configuration
# Minimal local setup for password-protected observability over site telemetry.
# Copy this file to .env and replace the placeholder secrets.

# Shared password for the protected admin panel.
AIWF_ADMIN_PASSWORD=change-me

# Secret used to sign the HttpOnly admin session cookie.
AIWF_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: where telemetry event files should be stored.
# If omitted, the app falls back to ../../data/telemetry from the web workspace.
AIWF_TELEMETRY_DIR=../../data/telemetry

# Optional: salt for hashing client IPs before telemetry persistence.
# If omitted, the app falls back to AIWF_ADMIN_SESSION_SECRET.
# AIWF_TELEMETRY_SALT=replace-with-a-stable-hashing-salt

# Optional: backend URL if you are also running the Python services locally.
# BACKEND_URL=http://localhost:8001