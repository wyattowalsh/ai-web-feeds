# ai-web-feeds environment configuration
# Copy this file to .env and replace placeholder values before running locally.

# Core storage and logging
AIWF_DATABASE_URL=sqlite:///data/ai-web-feeds.db
AIWF_LOGGING__LEVEL=INFO
# AIWF_LOGGING__FILE=true
# AIWF_LOGGING__FILE_PATH=logs/ai-web-feeds.log

# Admin-only observability access (the product has no end-user auth)
AIWF_ADMIN_PASSWORD=change-me
AIWF_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: keep anonymous browser-state binding separate from the admin secret.
# If omitted, the app falls back to AIWF_ADMIN_SESSION_SECRET.
# AIWF_ANON_BINDING_SECRET=replace-with-a-separate-binding-secret

# Optional telemetry storage and hashing overrides
AIWF_TELEMETRY_DIR=../../data/telemetry
# AIWF_TELEMETRY_SALT=replace-with-a-stable-hashing-salt

# Optional: backend URL if you are also running the Python services locally.
# BACKEND_URL=http://localhost:8001
