# better-auth + Neon PostgreSQL
# pragma: allowlist secret - example placeholder, replace with your actual values
DATABASE_URL="postgresql://user:pass@host.neon.tech/db?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# App URL for OAuth callbacks (auto-detected on Vercel, required for local dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: telemetry salt (falls back to BETTER_AUTH_SECRET)
# AIWF_TELEMETRY_SALT="optional-telemetry-salt"
