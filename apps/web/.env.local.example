# better-auth + Neon PostgreSQL
# pragma: allowlist secret - example placeholder, replace with your actual values
DATABASE_URL="postgresql://user:pass@host.neon.tech/db?sslmode=require"  # pragma: allowlist secret
BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"  # pragma: allowlist secret
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"  # pragma: allowlist secret
GOOGLE_CLIENT_SECRET="your-google-client-secret"  # pragma: allowlist secret
GITHUB_CLIENT_ID="your-github-client-id"  # pragma: allowlist secret
GITHUB_CLIENT_SECRET="your-github-client-secret"  # pragma: allowlist secret

# App URL for OAuth callbacks (auto-detected on Vercel, required for local dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email auth (magic link + verification)
RESEND_API_KEY="re_replace_me"  # pragma: allowlist secret
BETTER_AUTH_EMAIL_FROM="AI Web Feeds <noreply@yourdomain.com>"

# Comma-separated emails granted admin role on first sign-up (optional)
# BETTER_AUTH_ADMIN_EMAILS="you@example.com,ops@example.com"

# Optional: telemetry salt (falls back to BETTER_AUTH_SECRET)
# AIWF_TELEMETRY_SALT="optional-telemetry-salt"

# Optional: Python Logfire tracing (catalog_sync / CLI)
# LOGFIRE_TOKEN="replace-me"
# LOGFIRE_SERVICE_NAME="ai-web-feeds"
