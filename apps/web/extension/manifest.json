{
  "manifest_version": 3,
  "name": "AI Web Feeds Saver",
  "version": "0.1.0",
  "description": "Save articles and subscribe to feeds in AI Web Feeds.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save to AI Web Feeds"
  }
}
